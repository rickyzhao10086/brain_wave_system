rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validProfile(uid, data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'isAnonymous', 'consentActive',
          'careMode', 'sessionWindowSeconds', 'sessionNote', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'isAnonymous', 'consentActive',
          'careMode', 'sessionWindowSeconds', 'sessionNote', 'createdAt',
          'updatedAt', 'preferredDeviceName', 'lastDeviceAt'
        ])
        && data.uid == uid
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.isAnonymous == false
        && data.consentActive is bool
        && data.careMode in ['Care', 'Self', 'Research']
        && data.sessionWindowSeconds in [15, 30, 60]
        && data.sessionNote is string
        && data.sessionNote.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('preferredDeviceName' in data)
          || data.preferredDeviceName is string)
        && (!('lastDeviceAt' in data) || data.lastDeviceAt is timestamp);
    }

    function validSession(uid, data) {
      return data.keys().hasAll([
          'ownerId', 'status', 'source', 'deviceName', 'sampleRate',
          'batteryPercent', 'latestState', 'latestConfidence',
          'latestArtifact', 'sampleCount', 'sessionNote', 'startedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'status', 'source', 'deviceName', 'sampleRate',
          'batteryPercent', 'latestState', 'latestConfidence',
          'latestArtifact', 'sampleCount', 'sessionNote', 'startedAt',
          'updatedAt', 'endedAt'
        ])
        && data.ownerId == uid
        && data.status in ['active', 'complete']
        && data.source in ['directBle', 'bridge']
        && data.deviceName is string
        && data.sampleRate is int
        && (data.batteryPercent == null || data.batteryPercent is int)
        && data.latestState is string
        && data.latestConfidence is number
        && data.latestArtifact is string
        && data.sampleCount is int
        && data.sampleCount >= 0
        && data.sessionNote is string
        && data.sessionNote.size() <= 1000
        && data.startedAt is timestamp
        && data.updatedAt is timestamp
        && (!('endedAt' in data) || data.endedAt is timestamp);
    }

    function validSample(data) {
      return data.keys().hasAll([
          'capturedAt', 'state', 'confidence', 'artifact', 'contact',
          'bands', 'body', 'sampleRate', 'batteryPercent'
        ])
        && data.keys().hasOnly([
          'capturedAt', 'state', 'confidence', 'artifact', 'contact',
          'bands', 'body', 'sampleRate', 'batteryPercent'
        ])
        && data.capturedAt is timestamp
        && data.state is string
        && data.confidence is number
        && data.artifact is string
        && data.contact is map
        && data.bands is map
        && data.body is map
        && data.sampleRate is int
        && (data.batteryPercent == null || data.batteryPercent is int);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validProfile(uid, request.resource.data);
      allow delete: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSession(uid, request.resource.data);
        allow update: if isOwner(uid)
          && resource.data.ownerId == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.startedAt == resource.data.startedAt
          && validSession(uid, request.resource.data);
        allow delete: if isOwner(uid);

        match /samples/{sampleId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && validSample(request.resource.data);
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
